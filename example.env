########################################
# UHF Server Docker - example settings
# Copy to .env and edit: cp example.env .env
########################################

########################################
# Image
########################################

IMAGE_REGISTRY=ghcr.io/rydizz214/uhf-server-docker
IMAGE_TAG=2.2.1

# Combine overlays automatically instead of passing -f flags, e.g.:
#COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml:docker-compose.host-ffmpeg.yml

########################################
# Container
########################################

# UHF Server port inside the container
UHF_PORT=8000

# Port on the host
HOST_PORT=8000

# Host directory for recordings (mounted at /recordings)
HOST_RECORDINGS_DIR=./uhf-recordings

# Host directory for the server database (mounted at /var/lib/uhf-server)
HOST_UHF_DATA_DIR=./uhf-data

# Time zone, used for recurring recordings
TZ=America/New_York

########################################
# UHF Server
########################################

# Password the apps and the web app must present. Strongly recommended: without
# one, anyone who can reach the server can use it and its web app.
UHF_PASSWORD=

# Run Comskip on each finished recording (true/false or 1/0)
UHF_ENABLE_COMMERCIAL_DETECTION=true

# Comskip additional arguments
COMSKIP_ARGS=--ini

# Merge each finished recording into a single index.ts (true/false).
# The merge briefly needs twice the recording's size in free disk space.
UHF_SINGLE_FILE_RECORDINGS=false

# debug, info, warning, error or critical
LOG_LEVEL=info

########################################
# VPN (only with docker-compose.vpn.yml)
#
# gluetun supports 40+ providers. Variables for yours:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Every variable in this file is passed to gluetun.
########################################

#VPN_SERVICE_PROVIDER=mullvad
#VPN_TYPE=wireguard

# --- WireGuard (VPN_TYPE=wireguard) ---
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=
#WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s

# --- OpenVPN (VPN_TYPE=openvpn) ---
#OPENVPN_USER=
#OPENVPN_PASSWORD=

# --- Server selection ---
#SERVER_COUNTRIES=
#SERVER_CITIES=
#SERVER_HOSTNAMES=

# gluetun's own log level (LOG_LEVEL above is UHF Server's)
#GLUETUN_LOG_LEVEL=info
